rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // Products — staff can read, owner can write
    match /products/{id} {
      allow read: if isLoggedIn();
      allow write: if isOwner();
    }

    // Bills — all logged-in users can create, owner can delete/edit
    match /bills/{id} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isOwner();
    }

    // Customers
    match /customers/{id} {
      allow read, write: if isLoggedIn();
    }

    // Suppliers and purchases — owner only
    match /suppliers/{id} {
      allow read, write: if isOwner();
    }
    match /purchases/{id} {
      allow read, write: if isOwner();
    }

    // Payments
    match /payments/{id} {
      allow read, write: if isLoggedIn();
    }

    // Users — owner can read all, user can read own
    match /users/{uid} {
      allow read: if isLoggedIn() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    // Settings — owner only
    match /settings/{doc} {
      allow read: if isLoggedIn();
      allow write: if isOwner();
    }
  }
}
